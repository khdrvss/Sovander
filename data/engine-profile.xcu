<item oor:path="/org.openoffice.ucb.Configuration/ContentProviders/org.openoffice.ucb.Configuration:ContentProvidersDataPrimaryKeys['Local']/SecondaryKeys/org.openoffice.ucb.Configuration:ContentProvidersDataSecondaryKeys['Office']/ProviderData/org.openoffice.ucb.Configuration:ContentProviderData['Provider6']"><prop oor:name="URLTemplate" oor:op="fuse"><value>ftp</value></prop></item>
<item oor:path="/org.openoffice.ucb.Configuration/ContentProviders/org.openoffice.ucb.Configuration:ContentProvidersDataPrimaryKeys['Local']/SecondaryKeys/org.openoffice.ucb.Configuration:ContentProvidersDataSecondaryKeys['Office']/ProviderData/org.openoffice.ucb.Configuration:ContentProviderData['Provider12']"><prop oor:name="ServiceName" oor:op="fuse"><value></value></prop></item>
<item oor:path="/org.openoffice.ucb.Configuration/ContentProviders/org.openoffice.ucb.Configuration:ContentProvidersDataPrimaryKeys['Local']/SecondaryKeys/org.openoffice.ucb.Configuration:ContentProvidersDataSecondaryKeys['Office']/ProviderData/org.openoffice.ucb.Configuration:ContentProviderData['Provider12']"><prop oor:name="URLTemplate" oor:op="fuse"><value>https</value></prop></item>
<item oor:path="/org.openoffice.ucb.Configuration/ContentProviders/org.openoffice.ucb.Configuration:ContentProvidersDataPrimaryKeys['Local']/SecondaryKeys/org.openoffice.ucb.Configuration:ContentProvidersDataSecondaryKeys['Office']/ProviderData/org.openoffice.ucb.Configuration:ContentProviderData['Provider12a']"><prop oor:name="ServiceName" oor:op="fuse"><value></value></prop></item>
<item oor:path="/org.openoffice.ucb.Configuration/ContentProviders/org.openoffice.ucb.Configuration:ContentProvidersDataPrimaryKeys['Local']/SecondaryKeys/org.openoffice.ucb.Configuration:ContentProvidersDataSecondaryKeys['Office']/ProviderData/org.openoffice.ucb.Configuration:ContentProviderData['Provider12a']"><prop oor:name="URLTemplate" oor:op="fuse"><value>vnd.sun.star.webdavs</value></prop></item>
<item oor:path="/org.openoffice.ucb.Configuration/ContentProviders/org.openoffice.ucb.Configuration:ContentProvidersDataPrimaryKeys['Local']/SecondaryKeys/org.openoffice.ucb.Configuration:ContentProvidersDataSecondaryKeys['Office']/ProviderData/org.openoffice.ucb.Configuration:ContentProviderData['Provider12b']"><prop oor:name="ServiceName" oor:op="fuse"><value></value></prop></item>
