<item oor:path="/org.openoffice.ucb.Configuration/ContentProviders/org.openoffice.ucb.Configuration:ContentProvidersDataPrimaryKeys['Local']/SecondaryKeys/org.openoffice.ucb.Configuration:ContentProvidersDataSecondaryKeys['Office']/ProviderData/org.openoffice.ucb.Configuration:ContentProviderData['Provider999']"><prop oor:name="ServiceName" oor:op="fuse"><value></value></prop></item>
<item oor:path="/org.openoffice.ucb.Configuration/ContentProviders/org.openoffice.ucb.Configuration:ContentProvidersDataPrimaryKeys['Local']/SecondaryKeys/org.openoffice.ucb.Configuration:ContentProvidersDataSecondaryKeys['Office']/ProviderData/org.openoffice.ucb.Configuration:ContentProviderData['Provider999']"><prop oor:name="URLTemplate" oor:op="fuse"><value>.*</value></prop></item>
